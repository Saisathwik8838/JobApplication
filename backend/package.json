{
  "name": "@job-agent/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "prisma:generate": "prisma generate --schema src/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:e2e": "playwright test",
    "lint": "eslint src test",
    "build": "npm run prisma:generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@job-agent/shared-schemas": "*",
    "@prisma/client": "6.19.3",
    "bullmq": "^5.34.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.3",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.49.1",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
