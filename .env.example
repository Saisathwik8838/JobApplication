# Copy this file to .env.local. Do not commit that file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent?schema=public
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MATCH_THRESHOLD=75
REQUIRE_APPROVAL=true
MAX_APPLICATIONS_PER_DAY=20
PROFILE_PATH=../profile/candidate_profile.yaml
NOTIFICATION_FROM=job-agent@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
JWT_SECRET=dev-secret-job-agent-jwt-change-in-production
ALLOWED_ORIGINS=http://localhost:5173
HEADLESS=false
# Job discovery sources (comma-separated: adzuna, ncs, arbeitnow, remotive, company-career).
# Default sources configured for Indian job market:
# - Adzuna (country=in, Indian cities and tech hubs)
# - NCS (National Career Service via data.gov.in)
# - Arbeitnow (developer & tech listings with worldwide/remote)
# Note: Company career boards (Greenhouse / Lever public API boards) can be enabled via company-career.
#
# IMPORTANT NOTICE ON EXCLUDED PORTALS:
# Naukri, Foundit, Indeed, Shine, TimesJobs, and Apna are strictly OUT OF SCOPE.
# All six prohibit automated scraping/bot access in their published Terms of Service and operate
# enterprise anti-bot systems (e.g. Akamai Bot Manager). None expose a public job API.
# This agent does not use scraping workarounds or bot evasion against these portals.
JOB_SOURCES=adzuna,ncs,arbeitnow
# Adzuna settings (country defaults to 'in' for India; register at developer.adzuna.com)
ADZUNA_COUNTRY=in
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# National Career Service (data.gov.in API key and resource ID)
NCS_API_KEY=
NCS_RESOURCE_ID=
# Direct company career sources (JSON array of company board endpoints, e.g. [{"company":"Razorpay","ats":"greenhouse","boardToken":"razorpay"}])
COMPANY_CAREER_SOURCES=
# Continuous background discovery interval (cron format, default: every 15 minutes)
DISCOVERY_INTERVAL_CRON=*/15 * * * *
FRONTEND_URL=http://localhost:5173
NOTIFICATION_CHANNELS=email,webhook
NOTIFICATION_TO=
WEBHOOK_NOTIFICATION_URL=

