# Copy this file to .env.local. Do not commit that file.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://jobagent:jobagent@localhost:5432/jobagent?schema=public
REDIS_URL=redis://localhost:6379
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MATCH_THRESHOLD=75
REQUIRE_APPROVAL=true
MAX_APPLICATIONS_PER_DAY=20
PROFILE_PATH=../profile/candidate_profile.yaml
NOTIFICATION_FROM=job-agent@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
JWT_SECRET=dev-secret-job-agent-jwt-change-in-production
ALLOWED_ORIGINS=http://localhost:5173
HEADLESS=false
# Job discovery sources (comma-separated: remotive, arbeitnow, adzuna, rss, sample).
# Default enables Remotive (filtered for India/Worldwide) and Arbeitnow (worldwide/remote).
JOB_SOURCES=remotive,arbeitnow
# Optional Adzuna India API credentials (get free developer keys at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
NOTIFICATION_CHANNELS=email,webhook
WEBHOOK_NOTIFICATION_URL=
